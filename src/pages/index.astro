    <section id="tentang" class="mb-12 sm:mb-16 scroll-mt-24 reveal-on-scroll">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
        
        <!-- About Me -->
        <div class="lg:col-span-5 flex flex-col justify-between reveal-on-scroll delay-100">
          <div class="neo-box-lg bg-white p-6 sm:p-8 mb-6 lg:mb-0 flex-1">
            <h2 class="text-3xl font-black font-heading bg-[#39FF14] px-4 py-2 border-3 border-black inline-block transform -rotate-1 mb-6">
              Tentang Saya
            </h2>
            
            <p class="font-semibold text-gray-700 leading-relaxed mb-4 text-base sm:text-lg">
              Saya adalah seorang web developer independen yang mencintai kode bersih, arsitektur minimalis, dan visual yang berani. Saya percaya bahwa performa web adalah bagian penting dari User Experience.
            </p>
            <p class="font-semibold text-gray-700 leading-relaxed mb-6 text-base">
              Setiap baris kode yang saya tulis ditargetkan untuk performa optimal, kemudahan pemeliharaan, serta aksesibilitas tinggi bagi semua pengguna. Di waktu luang, saya senang bereksperimen dengan teknologi web baru dan mempelajari tren desain terkini.
            </p>

            <div class="bg-[#F4F4F0] border-3 border-black p-4 transform rotate-1 font-bold">
              <p class="text-sm italic">
                "Simplicity is the ultimate sophistication, but don't be afraid to make it bold and loud."
              </p>
            </div>
          </div>
        </div>

        <!-- Timeline -->
        <div class="lg:col-span-7 neo-box-lg bg-white p-6 sm:p-8 reveal-on-scroll delay-200">
          <h2 class="text-2xl sm:text-3xl font-black font-heading bg-[#FF6B00] text-white px-4 py-2 border-3 border-black inline-block transform rotate-1 mb-8">
            Pendidikan &amp; Organisasi
          </h2>

          <div class="relative pl-6 sm:pl-8 border-l-4 border-black space-y-8 py-2">
            {timeline.map((item) => (
              <div class="relative">
                <div class="absolute -left-[35px] sm:-left-[43px] top-1.5 w-6 h-6 bg-[#FFE600] border-3 border-black rounded-none transform rotate-45"></div>
                
                <div>
                  <span class="inline-block bg-black text-white text-xs font-bold px-2 py-0.5 mb-2">
                    {item.period}
                  </span>
                  <h3 class="text-lg sm:text-xl font-black font-heading leading-tight">{item.role}</h3>
                  <h4 class="text-sm font-bold text-gray-600 mb-3">{item.company}</h4>
                  <p class="text-sm font-semibold text-gray-700 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- CERTIFICATES SECTION -->
    <section id="sertifikat" class="mb-12 sm:mb-16 scroll-mt-24 reveal-on-scroll">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl sm:text-4xl font-black font-heading bg-[#FFE600] px-4 py-2 border-3 border-black inline-block transform -rotate-1">
          Sertifikasi &amp; Penghargaan
        </h2>
        <a href="/sertifikat" class="neo-btn bg-white text-black text-xs sm:text-sm font-extrabold px-4 py-2 border-2 border-black hidden sm:inline-flex">
          Halaman Sertifikat &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {certificates.map((cert, idx) => (
          <div class={`neo-box-lg bg-white p-6 flex flex-col justify-between reveal-on-scroll delay-${(idx + 1) * 75}`}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="neo-badge bg-[#39FF14] text-black">
                  {cert.category}
                </span>
                <span class="text-xs font-bold text-gray-600 bg-gray-100 px-2 py-0.5 border border-black">
                  {cert.date}
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-black font-heading leading-tight mb-2">
                {cert.title}
              </h3>
              <h4 class="text-sm font-extrabold text-gray-700 mb-4 flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#FF6B00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                <span>{cert.issuer}</span>
              </h4>
              <p class="text-sm font-semibold text-gray-700 leading-relaxed mb-6">
                {cert.description}
              </p>
            </div>

            <div class="flex items-center justify-between pt-4 border-t-2 border-black/10">
              <span class="text-[11px] font-mono font-bold text-gray-500">
                ID: {cert.credentialId}
              </span>
              {cert.credentialUrl && cert.credentialUrl !== '#' && (
                <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="neo-btn bg-[#FFE600] text-black text-xs font-extrabold px-3 py-1.5 flex items-center space-x-1">
                  <span>Verifikasi</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
      
      <div class="mt-6 text-center sm:hidden">
        <a href="/sertifikat" class="neo-btn bg-white text-black text-xs font-extrabold px-5 py-2.5 border-2 border-black inline-block">
          Halaman Sertifikat Lengkap &rarr;
        </a>
      </div>
    </section>

    <!-- CONTACT FORM SECTION -->
    <section id="kontak" class="mb-12 sm:mb-16 scroll-mt-24 reveal-on-scroll">
      <div class="neo-box-lg bg-white p-6 sm:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Contact Info -->
          <div class="lg:col-span-5 flex flex-col justify-between reveal-on-scroll delay-100">
            <div>
              <h2 class="text-3xl sm:text-4xl font-black font-heading bg-[#FFE600] px-4 py-2 border-3 border-black inline-block transform -rotate-1 mb-6">
                Hubungi Saya
              </h2>
              <p class="text-base sm:text-lg font-semibold text-gray-700 leading-relaxed mb-6">
                Ingin berkolaborasi untuk proyek berikutnya atau sekadar bertanya-tanya? Silakan isi formulir atau hubungi saya langsung melalui media sosial.
              </p>
            </div>

            <!-- Social Links Grid -->
            <div class="grid grid-cols-2 gap-4">
              <a href="https://github.com/Masykster" target="_blank" rel="noopener noreferrer" class="neo-btn bg-black text-white p-4 font-bold flex items-center justify-center space-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                <span>GitHub</span>
              </a>
              <a href="https://www.linkedin.com/in/abdullah-masykur" target="_blank" rel="noopener noreferrer" class="neo-btn bg-[#0077B5] text-white p-4 font-bold flex items-center justify-center space-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                <span>LinkedIn</span>
              </a>
            </div>
          </div>

          <!-- Form -->
          <div class="lg:col-span-7 reveal-on-scroll delay-200">
            <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
              <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY_HERE" />
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col">
                  <label for="name" class="font-bold text-sm mb-1 uppercase">Nama Lengkap</label>
                  <input type="text" id="name" name="name" required placeholder="John Doe" class="neo-input" />
                </div>
                <div class="flex flex-col">
                  <label for="email" class="font-bold text-sm mb-1 uppercase">Alamat Email</label>
                  <input type="email" id="email" name="email" required placeholder="john@example.com" class="neo-input" />
                </div>
              </div>

              <div class="flex flex-col">
                <label for="message" class="font-bold text-sm mb-1 uppercase">Pesan Anda</label>
                <textarea id="message" name="message" rows="4" required placeholder="Tulis pesan Anda di sini..." class="neo-input resize-none"></textarea>
              </div>

              <button type="submit" class="neo-btn bg-[#39FF14] text-black w-full py-4 text-base font-extrabold uppercase tracking-wide">
                Kirim Pesan
              </button>
            </form>
          </div>

        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="neo-box bg-white p-6 flex flex-col sm:flex-row items-center justify-between text-sm font-bold text-gray-700 reveal-on-scroll">
      <p>&copy; {new Date().getFullYear()} Masykster Portfolio. Hak Cipta Dilindungi.</p>
      <div class="flex items-center space-x-1.5 mt-4 sm:mt-0">
        <span>Status Pekerjaan:</span>
        <span class="bg-[#39FF14] border-2 border-black px-2 py-0.5 text-xs text-black">
          Tersedia untuk proyek baru 🟢
        </span>
      </div>
    </footer>

  </main>
</Layout>

<script>
  const initializeAnimations = () => {
    let lastScrollY = window.scrollY;
    let scrollTimeout: any = null;
    
    // 1. Scroll Velocity Marquee
    const updateMarqueeSpeed = () => {
      const marquees = document.querySelectorAll('.animate-marquee');
      const currentScroll = window.scrollY;
      const diff = Math.abs(currentScroll - lastScrollY);
      
      if (diff > 2) {
        const speedFactor = Math.min(Math.max(diff / 8, 1), 6);
        marquees.forEach((marquee: any) => {
          marquee.style.animationDuration = `${25 / speedFactor}s`;
        });
        
        if (scrollTimeout) clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          marquees.forEach((marquee: any) => {
            marquee.style.animationDuration = '25s';
          });
        }, 150);
      }
      
      lastScrollY = currentScroll;
    };

    window.addEventListener('scroll', updateMarqueeSpeed, { passive: true });

    // 2. Intersection Observer for stagger fade-in reveal on scroll
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-in');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.05,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  };

  const handlePageLoad = () => {
    initializeAnimations();
    
    // Captcha Gate unlock handler
    const gate = document.getElementById('captcha-gate');
    const skipBtn = document.getElementById('skip-btn');
    
    const unlockGate = (immediate = false) => {
      if (!gate) return;
      if (immediate) {
        gate.style.display = 'none';
        gate.remove();
        document.body.style.overflow = '';
        window.dispatchEvent(new CustomEvent('lenis-start'));
      } else {
        gate.style.opacity = '0';
        gate.style.pointerEvents = 'none';
        setTimeout(() => {
          gate.remove();
          document.body.style.overflow = '';
          window.dispatchEvent(new CustomEvent('lenis-start'));
        }, 500);
      }
    };

    // Lock page scroll initially if gate exists in DOM and sessionStorage is not set
    const verifiedSession = sessionStorage.getItem('playcaptcha-verified');
    if (gate && verifiedSession !== 'true') {
      document.body.style.overflow = 'hidden';
      window.dispatchEvent(new CustomEvent('lenis-stop'));
    } else if (gate && verifiedSession === 'true') {
      unlockGate(true);
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        sessionStorage.setItem('playcaptcha-verified', 'true');
        unlockGate(false);
      });
    }

    window.addEventListener('captcha-verified', (e: any) => {
      const immediate = e.detail?.immediate || false;
      unlockGate(immediate);
    });
  };

  document.addEventListener('astro:page-load', handlePageLoad);
</script>
