<script>
  const initializeAnimations = () => {
    let lastScrollY = window.scrollY;
    let scrollTimeout: any = null;
    
    // 1. Scroll Velocity Marquee
    const updateMarqueeSpeed = () => {
      const marquees = document.querySelectorAll('.animate-marquee');
      const currentScroll = window.scrollY;
      const diff = Math.abs(currentScroll - lastScrollY);
      
      if (diff > 2) {
        const speedFactor = Math.min(Math.max(diff / 8, 1), 6);
        marquees.forEach((marquee: any) => {
          marquee.style.animationDuration = `${25 / speedFactor}s`;
        });
        
        if (scrollTimeout) clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          marquees.forEach((marquee: any) => {
            marquee.style.animationDuration = '25s';
          });
        }, 150);
      }
      
      lastScrollY = currentScroll;
    };

    window.addEventListener('scroll', updateMarqueeSpeed, { passive: true });

    // 2. Intersection Observer for stagger fade-in reveal on scroll
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-in');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.05,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  };

  const handlePageLoad = () => {
    initializeAnimations();
    
    // Captcha Gate unlock handler
    const gate = document.getElementById('captcha-gate');
    const skipBtn = document.getElementById('skip-btn');
    
    const unlockGate = (immediate = false) => {
      if (!gate) return;
      if (immediate) {
        gate.style.display = 'none';
        gate.remove();
        document.body.style.overflow = '';
        window.dispatchEvent(new CustomEvent('lenis-start'));
      } else {
        gate.style.opacity = '0';
        gate.style.pointerEvents = 'none';
        setTimeout(() => {
          gate.remove();
          document.body.style.overflow = '';
          window.dispatchEvent(new CustomEvent('lenis-start'));
        }, 500);
      }
    };

    // Lock page scroll initially if gate exists in DOM and sessionStorage is not set
    const verifiedSession = sessionStorage.getItem('playcaptcha-verified');
    if (gate && verifiedSession !== 'true') {
      document.body.style.overflow = 'hidden';
      window.dispatchEvent(new CustomEvent('lenis-stop'));
    } else if (gate && verifiedSession === 'true') {
      unlockGate(true);
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        sessionStorage.setItem('playcaptcha-verified', 'true');
        unlockGate(false);
      });
    }

    window.addEventListener('captcha-verified', (e: any) => {
      const immediate = e.detail?.immediate || false;
      unlockGate(immediate);
    });
  };

  document.addEventListener('astro:page-load', handlePageLoad);
</script>
