                  <input type="text" id="name" name="name" required placeholder="John Doe" class="neo-input" />
                </div>
                <div class="flex flex-col">
                  <label for="email" class="font-bold text-sm mb-1 uppercase">Alamat Email</label>
                  <input type="email" id="email" name="email" required placeholder="john@example.com" class="neo-input" />
                </div>
              </div>

              <div class="flex flex-col">
                <label for="message" class="font-bold text-sm mb-1 uppercase">Pesan Anda</label>
                <textarea id="message" name="message" rows="4" required placeholder="Tulis pesan Anda di sini..." class="neo-input resize-none"></textarea>
              </div>

              <button type="submit" class="neo-btn bg-[#39FF14] text-black w-full py-4 text-base font-extrabold uppercase tracking-wide">
                Kirim Pesan
              </button>
            </form>
          </div>

        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="neo-box bg-white p-6 flex flex-col sm:flex-row items-center justify-between text-sm font-bold text-gray-700 reveal-on-scroll">
      <p>&copy; {new Date().getFullYear()} Masykster Portfolio. Hak Cipta Dilindungi.</p>
      <div class="flex items-center space-x-1.5 mt-4 sm:mt-0">
        <span>Status Pekerjaan:</span>
        <span class="bg-[#39FF14] border-2 border-black px-2 py-0.5 text-xs text-black">
          Tersedia untuk proyek baru 🟢
        </span>
      </div>
    </footer>

  </main>
</Layout>

<script>
  const initializeAnimations = () => {
    let lastScrollY = window.scrollY;
    let scrollTimeout: any = null;
    
    // 1. Scroll Velocity Marquee
    const updateMarqueeSpeed = () => {
      const marquees = document.querySelectorAll('.animate-marquee');
      const currentScroll = window.scrollY;
      const diff = Math.abs(currentScroll - lastScrollY);
      
      if (diff > 2) {
        const speedFactor = Math.min(Math.max(diff / 8, 1), 6);
        marquees.forEach((marquee: any) => {
          marquee.style.animationDuration = `${25 / speedFactor}s`;
        });
        
        if (scrollTimeout) clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          marquees.forEach((marquee: any) => {
            marquee.style.animationDuration = '25s';
          });
        }, 150);
      }
      
      lastScrollY = currentScroll;
    };

    window.addEventListener('scroll', updateMarqueeSpeed, { passive: true });

    // 2. Intersection Observer for stagger fade-in reveal on scroll
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-in');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.05,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  };

  const handlePageLoad = () => {
    initializeAnimations();
    
    // Captcha Gate unlock handler
    const gate = document.getElementById('captcha-gate');
    const skipBtn = document.getElementById('skip-btn');
    
    const unlockGate = (immediate = false) => {
      if (!gate) return;
      if (immediate) {
        gate.style.display = 'none';
        gate.remove();
        document.body.style.overflow = '';
        window.dispatchEvent(new CustomEvent('lenis-start'));
      } else {
        gate.style.opacity = '0';
        gate.style.pointerEvents = 'none';
        setTimeout(() => {
          gate.remove();
          document.body.style.overflow = '';
          window.dispatchEvent(new CustomEvent('lenis-start'));
        }, 500);
      }
    };

    // Lock page scroll initially if gate exists in DOM and sessionStorage is not set
    const verifiedSession = sessionStorage.getItem('playcaptcha-verified');
    if (gate && verifiedSession !== 'true') {
      document.body.style.overflow = 'hidden';
      window.dispatchEvent(new CustomEvent('lenis-stop'));
    } else if (gate && verifiedSession === 'true') {
      unlockGate(true);
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        sessionStorage.setItem('playcaptcha-verified', 'true');
        unlockGate(false);
      });
    }

    window.addEventListener('captcha-verified', (e: any) => {
      const immediate = e.detail?.immediate || false;
      unlockGate(immediate);
    });
  };

  document.addEventListener('astro:page-load', handlePageLoad);
</script>
