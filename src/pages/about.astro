---
import Layout from '../layouts/Layout.astro';

// Tech Stack categories using official Devicon CDN URLs
const skillCategories = [
  {
    title: "Frontend & Mobile",
    color: "bg-[#FFE600]", // Yellow
    skills: [
      { name: "HTML5", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg" },
      { name: "CSS3", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg" },
      { name: "JavaScript", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" },
      { name: "TypeScript", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg" },
      { name: "React.js", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg" },
      { name: "Next.js", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg" },
      { name: "Vue.js", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vuejs/vuejs-original.svg" },
      { name: "Inertia.js", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/inertiajs/inertiajs-original.svg" },
      { name: "Tailwind CSS", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg" },
      { name: "Flutter", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/flutter/flutter-original.svg" },
      { name: "Dart", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/dart/dart-original.svg" }
    ]
  },
  {
    title: "Backend & Database",
    color: "bg-[#39FF14]", // Green
    skills: [
      { name: "Laravel", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/laravel/laravel-original.svg" },
      { name: "PHP", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/php/php-original.svg" },
      { name: "Supabase", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/supabase/supabase-original.svg" },
      { name: "Firebase", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/firebase/firebase-original.svg" },
      { name: "MySQL", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg" },
      { name: "PostgreSQL", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg" }
    ]
  },
  {
    title: "DevOps & Tools",
    color: "bg-[#00E5FF]", // Blue
    skills: [
      { name: "Docker", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" },
      { name: "Git & GitHub", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg" },
      { name: "Vercel", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vercel/vercel-original.svg" },
      { name: "Postman", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postman/postman-original.svg" },
      { name: "Sentry", deviconUrl: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sentry/sentry-original.svg" }
    ]
  }
];

const timeline = [
  {
    period: "Agustus 2024 – Sekarang",
    role: "D4 Manajemen Informatika (GPA: 3.93 / 4.00)",
    company: "Universitas Negeri Surabaya",
    description: "Aktif dalam pengembangan proyek berbasis web & mobile."
  },
  {
    period: "Agustus 2021 – Juli 2024",
    role: "Ilmu Pengetahuan Alam (IPA)",
    company: "SMA Negeri 13 Surabaya",
    description: "Menempuh pendidikan sekolah menengah atas dengan peminatan Ilmu Pengetahuan Alam."
  }
];
---

<Layout title="About | Abdullah Masykur" description="Tentang Abdullah Masykur - Web Developer & Software Engineer berlokasi di Surabaya dengan keahlian di Astro, React, Laravel, dan Neobrutalisme.">
  <div class="font-sans space-y-10">
    
    <!-- TITLE BANNER -->
    <div class="neo-box-lg bg-white p-6 sm:p-8 reveal-scale">
      <div class="inline-block bg-[#FFE600] text-black font-extrabold text-xs sm:text-sm px-3 py-1 border-2 border-black mb-3 uppercase tracking-wider rounded-[5px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        About Me
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-heading tracking-tight mb-3">
        Abdullah Masykur
      </h1>
      <p class="text-base sm:text-lg font-semibold text-gray-700 dark:text-gray-200 leading-relaxed">
        Halo! Saya Abdullah Masykur, seorang Web Developer &amp; Software Engineer berlokasi di Surabaya, Indonesia. Berfokus pada performa tinggi, aksesibilitas, dan antarmuka pengguna Neobrutalisme yang unik.
      </p>

      <div class="flex flex-wrap gap-3 mt-6">
        <a href="https://github.com/Masykster" target="_blank" rel="noopener noreferrer" class="neo-btn bg-black text-white px-4 py-2 text-xs sm:text-sm font-extrabold flex items-center space-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span>GitHub</span>
        </a>

        <a href="https://www.linkedin.com/in/abdullah-masykur" target="_blank" rel="noopener noreferrer" class="neo-btn bg-[#0077B5] text-white px-4 py-2 text-xs sm:text-sm font-extrabold flex items-center space-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          <span>LinkedIn</span>
        </a>

        <a href="mailto:masykur6060@gmail.com" class="neo-btn bg-[#FFE600] text-black px-4 py-2 text-xs sm:text-sm font-extrabold flex items-center space-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>Email</span>
        </a>
      </div>
    </div>

    <!-- KEAHLIAN / SKILLS SECTION -->
    <section id="skills" class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black font-heading bg-[#00E5FF] text-black px-4 py-2 border-2 border-black inline-block rounded-[5px] shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        Keahlian &amp; Teknologi
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {skillCategories.map((category, catIdx) => {
          const animClass = catIdx === 0 ? 'reveal-left' : catIdx === 1 ? 'reveal-bottom' : 'reveal-right';
          return (
            <div class={`neo-box-lg bg-white overflow-hidden ${animClass}`}>
              <div class={`${category.color} p-4 border-b-2 border-black`}>
                <h3 class="text-lg font-black font-heading text-black uppercase">
                  {category.title}
                </h3>
              </div>
              <div class="p-5">
                <div class="flex flex-wrap gap-3 justify-center sm:justify-start">
                  {category.skills.map((skill) => (
                    <div class="relative group flex justify-center items-center">
                      <!-- Logo-Only Box (Solid White Background) -->
                      <div class="w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center p-2.5 border-2 border-black rounded-[5px] !bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,1)] hover:translate-x-[2px] hover:translate-y-[2px] transition-all cursor-pointer">
                        <img 
                          src={skill.deviconUrl} 
                          alt={skill.name} 
                          loading="lazy" 
                          class="w-7 h-7 sm:w-8 sm:h-8 object-contain"
                        />
                      </div>

                      <!-- Neo-Brutalist Tooltip (Appears on Hover) -->
                      <div class="absolute -top-11 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none z-30 whitespace-nowrap bg-white text-black font-black text-xs px-2.5 py-1 border-2 border-black rounded-[5px] shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:bg-[#1E1E1E] dark:text-white dark:border-white dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,1)]">
                        {skill.name}
                        <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-2.5 h-2.5 bg-white dark:bg-[#1E1E1E] border-r-2 border-b-2 border-black dark:border-white rotate-45"></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- TIMELINE SECTION -->
    <section id="experience" class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-black font-heading bg-[#39FF14] text-black px-4 py-2 border-2 border-black inline-block rounded-[5px] shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        Pendidikan &amp; Pengalaman
      </h2>

      <div class="space-y-4">
        {timeline.map((item, tIdx) => {
          const tAnimClass = tIdx % 2 === 0 ? 'reveal-left' : 'reveal-right';
          return (
            <div class={`neo-box bg-white p-6 flex flex-col justify-between ${tAnimClass}`}>
              <div class="flex items-center justify-between mb-3">
                <span class="neo-badge bg-[#FFE600] text-black">
                  {item.company}
                </span>
                <span class="text-xs font-bold text-gray-700 bg-gray-100 px-2.5 py-1 border border-black rounded-[4px]">
                  {item.period}
                </span>
              </div>
              <h3 class="text-xl font-black font-heading mb-2">{item.role}</h3>
              <p class="text-sm font-semibold text-gray-700 leading-relaxed">{item.description}</p>
            </div>
          );
        })}
      </div>
    </section>

  </div>
</Layout>
