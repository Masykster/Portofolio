---
import Layout from '../layouts/Layout.astro';

const certificates = [
  {
    title: "Belajar Dasar Pemrograman Web",
    issuer: "Dicoding Indonesia",
    date: "2024",
    credentialId: "DICODING-WEB-2024",
    credentialUrl: "https://www.dicoding.com",
    category: "Web Development",
    color: "#FFE600",
    imageUrl: "", // Opsional: URL gambar sertifikat dari Cloudinary
    description: "Sertifikasi kelulusan dasar pemrograman web melingkupi HTML5, CSS3, layouting responsif dengan Flexbox & Grid, serta pengenalan standar web W3C."
  },
  {
    title: "Belajar Membuat Aplikasi Web dengan React",
    issuer: "Dicoding Indonesia",
    date: "2024",
    credentialId: "DICODING-REACT-2024",
    credentialUrl: "https://www.dicoding.com",
    category: "Frontend",
    color: "#00E5FF",
    imageUrl: "",
    description: "Kompetensi pembuatan Single Page Application (SPA) modular berbasis React.js, State Management (Hooks & Context), dan konsumsi RESTful API."
  },
  {
    title: "Belajar Dasar Pemrograman JavaScript",
    issuer: "Dicoding Indonesia",
    date: "2024",
    credentialId: "DICODING-JS-2024",
    credentialUrl: "https://www.dicoding.com",
    category: "Programming",
    color: "#39FF14",
    imageUrl: "",
    description: "Penguasaan sintaksis modern ECMAScript 6+ (ES6+), Asynchronous JavaScript (Promises & Async/Await), Manipulasi DOM, dan OOP."
  },
];
---

<Layout title="Sertifikat & Penghargaan | Abdullah Masykur" description="Daftar lengkap sertifikasi pemrograman, pengembangan web, dan lisensi kualifikasi Abdullah Masykur.">
  <div class="font-sans space-y-8">
    
    <!-- TITLE BANNER -->
    <div class="neo-box-lg bg-white p-6 sm:p-8 reveal-scale">
      <div class="inline-block bg-[#39FF14] text-black font-extrabold text-xs sm:text-sm px-3 py-1 border-2 border-black mb-3 uppercase tracking-wider rounded-[5px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        Kredensial &amp; Prestasi ({certificates.length})
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-heading tracking-tight mb-3">
        Sertifikasi Resmi
      </h1>
      <p class="text-base sm:text-lg font-semibold text-gray-700 dark:text-gray-200 leading-relaxed">
        Daftar lisensi, sertifikat kelulusan, dan penghargaan resmi yang telah saya raih dalam pengembangan web dan kegiatan akademis/organisasi.
      </p>
    </div>

    <!-- CERTIFICATES GRID -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 lg:gap-8 mb-12">
      {certificates.map((cert, cIdx) => {
        const cAnimClass = cIdx % 2 === 0 ? 'reveal-left' : 'reveal-right';
        return (
          <div class={`neo-box-lg bg-white p-3.5 sm:p-8 flex flex-col justify-between group hover:-translate-y-1 transition-transform ${cAnimClass}`}>
          <div>
            {cert.imageUrl && (
              <div class="mb-4 h-36 sm:h-48 border-2 border-black rounded-[5px] bg-gray-100 overflow-hidden relative shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <img 
                  src={cert.imageUrl} 
                  alt={cert.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
                />
              </div>
            )}

            <div class="flex items-center justify-between mb-4">
              <span class="neo-badge bg-[#FFE600] text-black">
                {cert.category}
              </span>
              <span class="text-xs font-bold text-gray-700 bg-gray-100 px-2.5 py-1 border border-black">
                {cert.date}
              </span>
            </div>

            <h2 class="text-2xl font-black font-heading leading-tight mb-3">
              {cert.title}
            </h2>

            <div class="flex items-center space-x-2 text-sm font-extrabold text-gray-800 mb-4">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B00] inline-block border border-black"></span>
              <span>Penerbit: {cert.issuer}</span>
            </div>

            <p class="text-sm font-semibold text-gray-700 leading-relaxed mb-6">
              {cert.description}
            </p>
          </div>

          <div class="flex items-center justify-between pt-4 border-t-2 border-black/10 mt-2">
            <span class="text-xs font-mono font-bold text-gray-500">
              ID: {cert.credentialId}
            </span>

            {cert.credentialUrl && cert.credentialUrl !== '#' && (
              <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="neo-btn bg-[#39FF14] text-black text-xs font-extrabold px-4 py-2 flex items-center space-x-1.5">
                <span>Verifikasi Kredensial</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </a>
            )}
          </div>
        </div>
        );
      })}
    </div>

    <!-- FOOTER LINK -->
    <div class="text-center py-6">
      <a href="/" class="neo-btn bg-[#FF6B00] text-white px-8 py-3.5 text-sm sm:text-base font-extrabold uppercase tracking-wider">
        &larr; Kembali ke Beranda Utama
      </a>
    </div>

  </main>
</Layout>
