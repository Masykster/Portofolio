---
import Layout from '../layouts/Layout.astro';

const certificates = [
  {
    title: "Belajar Dasar Pemrograman Web",
    issuer: "Dicoding Indonesia",
    date: "2024",
    credentialId: "DICODING-WEB-2024",
    credentialUrl: "https://www.dicoding.com",
    category: "Web Development",
    color: "#FFE600",
    description: "Sertifikasi kelulusan dasar pemrograman web melingkupi HTML5, CSS3, layouting responsif dengan Flexbox & Grid, serta pengenalan standar web W3C."
  },
  {
    title: "Belajar Membuat Aplikasi Web dengan React",
    issuer: "Dicoding Indonesia",
    date: "2024",
    credentialId: "DICODING-REACT-2024",
    credentialUrl: "https://www.dicoding.com",
    category: "Frontend",
    color: "#00E5FF",
    description: "Kompetensi pembuatan Single Page Application (SPA) modular berbasis React.js, State Management (Hooks & Context), dan konsumsi RESTful API."
  },
  {
    title: "Belajar Dasar Pemrograman JavaScript",
    issuer: "Dicoding Indonesia",
    date: "2024",
    credentialId: "DICODING-JS-2024",
    credentialUrl: "https://www.dicoding.com",
    category: "Programming",
    color: "#39FF14",
    description: "Penguasaan sintaksis modern ECMAScript 6+ (ES6+), Asynchronous JavaScript (Promises & Async/Await), Manipulasi DOM, dan OOP."
  },
  {
    title: "Panitia MI EXPO 2024 (Divisi Humas)",
    issuer: "Hima Manajemen Informatika UNESA",
    date: "Desember 2024",
    credentialId: "UNESA-MIEXPO-2024",
    credentialUrl: "#",
    category: "Organisasi",
    color: "#FF6B00",
    description: "Sertifikat penghargaan atas kontribusi aktif dalam Divisi Humas pada penyelenggaraan acara MI EXPO 2024 di Universitas Negeri Surabaya."
  }
];
---

<Layout title="Sertifikat & Penghargaan | Abdullah Masykur" description="Daftar lengkap sertifikasi pemrograman, pengembangan web, dan lisensi kualifikasi Abdullah Masykur.">
  <main class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-8 font-sans">
    
    <!-- HEADER NAV -->
    <div class="mb-10 flex items-center justify-between">
      <a href="/" class="neo-btn bg-[#FFE600] text-black px-4 py-2 text-xs sm:text-sm font-extrabold flex items-center space-x-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <span>Kembali ke Beranda</span>
      </a>

      <div class="flex items-center space-x-3 sm:space-x-4">
        <a href="/projek" class="neo-btn bg-white text-black px-4 py-2 text-xs sm:text-sm font-extrabold border-2 border-black">
          Projek &rarr;
        </a>
        <button id="theme-toggle" type="button" aria-label="Toggle Theme" class="neo-btn bg-[#FFE600] text-black text-xs sm:text-sm px-3.5 py-2 sm:px-4 sm:py-2 font-extrabold flex items-center space-x-1.5 border-2 border-black cursor-pointer select-none">
          <span id="theme-toggle-icon">🌙</span>
          <span id="theme-toggle-text" class="uppercase font-heading">Dark</span>
        </button>
      </div>
    </div>

    <!-- TITLE BANNER -->
    <div class="neo-box-lg bg-white p-6 sm:p-10 mb-10">
      <div class="inline-block bg-[#39FF14] text-black font-extrabold text-xs sm:text-sm px-3 py-1 border-2 border-black mb-4 uppercase tracking-wider transform -rotate-1">
        Kredensial &amp; Prestasi
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-heading tracking-tight mb-4 leading-tight">
        Sertifikasi <span class="bg-[#FFE600] inline-block px-2 border-2 border-black transform rotate-1">Resmi</span>
      </h1>
      <p class="text-base sm:text-lg font-semibold text-gray-700 max-w-2xl leading-relaxed">
        Berikut adalah lisensi, sertifikat kelulusan, dan penghargaan resmi yang telah saya raih dalam pengembangan web dan kegiatan akademis/organisasi.
      </p>
    </div>

    <!-- CERTIFICATES GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-12">
      {certificates.map((cert) => (
        <div class="neo-box-lg bg-white p-6 sm:p-8 flex flex-col justify-between group hover:-translate-y-1 transition-transform">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="neo-badge bg-[#FFE600] text-black">
                {cert.category}
              </span>
              <span class="text-xs font-bold text-gray-700 bg-gray-100 px-2.5 py-1 border border-black">
                {cert.date}
              </span>
            </div>

            <h2 class="text-2xl font-black font-heading leading-tight mb-3">
              {cert.title}
            </h2>

            <div class="flex items-center space-x-2 text-sm font-extrabold text-gray-800 mb-4">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B00] inline-block border border-black"></span>
              <span>Penerbit: {cert.issuer}</span>
            </div>

            <p class="text-sm font-semibold text-gray-700 leading-relaxed mb-6">
              {cert.description}
            </p>
          </div>

          <div class="flex items-center justify-between pt-4 border-t-2 border-black/10 mt-2">
            <span class="text-xs font-mono font-bold text-gray-500">
              ID: {cert.credentialId}
            </span>

            {cert.credentialUrl && cert.credentialUrl !== '#' && (
              <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="neo-btn bg-[#39FF14] text-black text-xs font-extrabold px-4 py-2 flex items-center space-x-1.5">
                <span>Verifikasi Kredensial</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- FOOTER LINK -->
    <div class="text-center py-6">
      <a href="/" class="neo-btn bg-[#FF6B00] text-white px-8 py-3.5 text-sm sm:text-base font-extrabold uppercase tracking-wider">
        &larr; Kembali ke Beranda Utama
      </a>
    </div>

  </main>

  <script>
    const initThemeToggle = () => {
      const toggleBtn = document.getElementById('theme-toggle');
      const iconEl = document.getElementById('theme-toggle-icon');
      const textEl = document.getElementById('theme-toggle-text');

      const updateUI = (isDark: boolean) => {
        if (iconEl && textEl) {
          iconEl.textContent = isDark ? '☀️' : '🌙';
          textEl.textContent = isDark ? 'Light' : 'Dark';
        }
      };

      const isDark = document.documentElement.classList.contains('dark');
      updateUI(isDark);

      if (toggleBtn) {
        toggleBtn.onclick = () => {
          const willBeDark = !document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', willBeDark);
          localStorage.setItem('theme', willBeDark ? 'dark' : 'light');
          updateUI(willBeDark);
        };
      }
    };

    document.addEventListener('astro:page-load', initThemeToggle);
  </script>
</Layout>
