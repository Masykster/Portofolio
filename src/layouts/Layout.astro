---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Masykster | Web Developer Portfolio',
  description = 'Portofolio profesional Masykster, seorang Web Developer yang berspesialisasi dalam membangun aplikasi web modern, cepat, dan unik dengan estetika Neo-Brutalisme.'
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" href="favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Astro native Client Router for smooth page transitions -->
    <ClientRouter />
  </head>
  <body class="bg-[#F4F4F0] text-[#000000] min-h-screen antialiased selection:bg-[#FFE600] selection:text-black">
    <slot />

    <!-- Smooth scrolling library Lenis -->
    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;

      const initLenis = () => {
        if (lenis) {
          lenis.destroy();
        }

        // Initialize Lenis with smooth settings
        lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          infinite: false,
          autoRaf: true,
        });

        // Lock scroll initially if gate is active and sessionStorage is not verified
        const gate = document.getElementById('captcha-gate');
        const verifiedSession = sessionStorage.getItem('playcaptcha-verified');
        if (gate && verifiedSession !== 'true') {
          lenis.stop();
        }

        // Window event listeners to freeze/unfreeze scroll from the captcha gate triggers
        window.addEventListener('lenis-stop', () => {
          lenis?.stop();
        });

        window.addEventListener('lenis-start', () => {
          lenis?.start();
        });
      };

      document.addEventListener('astro:page-load', initLenis);
    </script>
  </body>
</html>
