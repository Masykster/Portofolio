---
import { ClientRouter } from 'astro:transitions';
import PixelTrailBackground from '../components/PixelTrailBackground';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  deskfolio?: boolean;
}

const { 
  title = 'Abdullah Masykur — Portofolio & Software Engineer | Masykster',
  description = 'Portofolio resmi Abdullah Masykur (Masykster) — Software Engineer & Web Developer dari Surabaya, mahasiswa D4 Manajemen Informatika Universitas Negeri Surabaya (UNESA). Berpengalaman dalam Astro, React, Next.js, Laravel, dan AI.',
  image = 'https://masykster.is-a.dev/profile.webp',
  keywords = 'Abdullah Masykur, Masykster, Portofolio Abdullah Masykur, Abdullah Masykur UNESA, Abdullah Masykur Surabaya, Software Engineer, Web Developer, Web Developer Surabaya, D4 Manajemen Informatika UNESA, Universitas Negeri Surabaya, Astro Developer, React Developer, Laravel Developer, Next.js, Frontend Developer, Fullstack Developer, DeskFolio, Angonku.id, CuanLagi-AI, EcoFlow, DailyBit, Ascendemy',
  deskfolio = true
} = Astro.props;

const siteUrl = 'https://masykster.is-a.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="id" class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" href="/favicon.ico?v=3" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Deskfolio Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:opsz,wght@14..32,400..700&family=Quicksand:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="8d1kGEVyTtO8m5ulywFxlRrQBX3nQOZFGjBATcYNpgk" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Abdullah Masykur" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Abdullah Masykur - Software Engineer & Web Developer Portfolio" />
    <meta property="og:site_name" content="Abdullah Masykur Portfolio (Masykster)" />
    <meta property="og:locale" content="id_ID" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@Masykster" />

    <!-- Schema.org JSON-LD Structured Data for Google Search Engine Knowledge Graph -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://masykster.is-a.dev/#person",
          "name": "Abdullah Masykur",
          "alternateName": ["Masykster", "Abdullah Masykur UNESA", "Masykur"],
          "url": "https://masykster.is-a.dev/",
          "image": "https://masykster.is-a.dev/profile.webp",
          "jobTitle": "Software Engineer & Web Developer",
          "description": "Software Engineer & Web Developer berlokasi di Surabaya dengan keahlian di bidang Astro, React, TypeScript, Next.js, Laravel, dan kecerdasan buatan (AI). Mahasiswa D4 Manajemen Informatika di Universitas Negeri Surabaya.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Surabaya",
            "addressRegion": "Jawa Timur",
            "addressCountry": "ID"
          },
          "alumniOf": [
            {
              "@type": "EducationalOrganization",
              "name": "Universitas Negeri Surabaya",
              "department": "D4 Manajemen Informatika",
              "url": "https://unesa.ac.id"
            },
            {
              "@type": "EducationalOrganization",
              "name": "SMA Negeri 13 Surabaya"
            }
          ],
          "worksFor": {
            "@type": "Organization",
            "name": "Ascendemy",
            "jobTitle": "Web Developer Intern"
          },
          "sameAs": [
            "https://github.com/Masykster",
            "https://www.linkedin.com/in/abdullah-masykur",
            "mailto:masykur6060@gmail.com"
          ],
          "knowsAbout": [
            "Software Engineering",
            "Web Development",
            "Frontend Development",
            "Fullstack Development",
            "Astro",
            "React.js",
            "Next.js",
            "Laravel",
            "TypeScript",
            "Tailwind CSS",
            "Flutter",
            "PostgreSQL",
            "Supabase",
            "REST API",
            "Artificial Intelligence",
            "UI/UX Design"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://masykster.is-a.dev/#website",
          "url": "https://masykster.is-a.dev/",
          "name": "Abdullah Masykur — Portofolio & Software Engineer",
          "description": "Portofolio resmi Abdullah Masykur (Masykster) — Software Engineer & Web Developer.",
          "publisher": {
            "@id": "https://masykster.is-a.dev/#person"
          },
          "inLanguage": ["id-ID", "en-US"]
        },
        {
          "@type": "ProfilePage",
          "@id": "https://masykster.is-a.dev/#profilepage",
          "url": "https://masykster.is-a.dev/",
          "name": "Abdullah Masykur Portfolio",
          "isPartOf": {
            "@id": "https://masykster.is-a.dev/#website"
          },
          "mainEntity": {
            "@id": "https://masykster.is-a.dev/#person"
          }
        }
      ]
    })} />

    <!-- Inline Dark Mode initialization script to prevent FOUC -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      };

      const theme = getTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Astro native Client Router for smooth page transitions -->
    <ClientRouter />
  </head>
  <body class={deskfolio ? "relative min-h-screen w-screen h-screen overflow-hidden m-0 p-0" : "relative min-h-screen antialiased selection:bg-[#FFE600] selection:text-black transition-colors duration-200"}>
    {deskfolio ? (
      <slot />
    ) : (
      <>
        <!-- Interactive Pixel Trail Background -->
        <PixelTrailBackground client:only="react" />
        
        <!-- Floating Navbar in neobrutalism-templates style -->
        <div class="fixed top-4 sm:top-5 left-0 z-50 w-full px-4">
          <nav class="mx-auto flex w-full md:w-max items-center justify-between md:justify-start gap-2 sm:gap-4 border-2 border-black rounded-[5px] bg-[#FF6B00] text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-2 px-3 sm:px-5 text-xs sm:text-base font-bold relative">
            
            <!-- Mobile Brand Label (Hidden on tablet/desktop) -->
            <a href="/" class="md:hidden font-black uppercase text-sm tracking-wider flex items-center gap-1.5 px-2.5 py-1 bg-white text-black border-2 border-black rounded-[5px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
              <span>Masykster</span>
            </a>

            <!-- Desktop Navigation Links (Visible on tablet/desktop >= 768px) -->
            <div class="hidden md:flex items-center gap-2 sm:gap-4">
              <a href="/" class="hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-2 py-1 transition-colors">
                Home
              </a>
              <a href="/about" class="hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-2 py-1 transition-colors">
                About
              </a>
              <a href="/projek" class="hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-2 py-1 transition-colors">
                Projek
              </a>
              <a href="/sertifikat" class="hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-2 py-1 transition-colors">
                Sertifikat
              </a>
              
              <div class="border-l-2 border-black h-5 mx-0.5 sm:mx-1"></div>
            </div>

            <div class="flex items-center gap-2">
              <!-- Theme Switcher -->
              <button
                id="theme-toggle"
                aria-label="Toggle Dark Mode"
                class="neo-btn bg-white text-black p-1.5 w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center border-2 border-black rounded-[5px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-all cursor-pointer"
              >
                <!-- Moon Icon (Light mode) -->
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 block dark:hidden text-black stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
                <!-- Sun Icon (Dark mode) -->
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden dark:block text-[#FFE600] stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                </svg>
              </button>

              <!-- Mobile Hamburger Toggle Button (ONLY visible on mobile < 768px) -->
              <button
                id="mobile-menu-btn"
                aria-label="Toggle Mobile Menu"
                aria-expanded="false"
                class="md:hidden neo-btn bg-white text-black p-1.5 w-8 h-8 flex items-center justify-center border-2 border-black rounded-[5px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-all cursor-pointer"
              >
                <!-- Hamburger Icon -->
                <svg id="hamburger-icon" class="w-4 h-4 block stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="4" x2="20" y1="6" y2="6"/>
                  <line x1="4" x2="20" y1="12" y2="12"/>
                  <line x1="4" x2="20" y1="18" y2="18"/>
                </svg>
                <!-- Close (X) Icon -->
                <svg id="close-icon" class="w-4 h-4 hidden stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </div>

            <!-- Mobile Dropdown Menu -->
            <div 
              id="mobile-menu"
              class="hidden md:hidden absolute top-full left-0 right-0 mt-2 border-2 border-black rounded-[5px] bg-[#FF6B00] text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-3 flex-col gap-2 font-bold z-50"
            >
              <a href="/" class="block hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-3 py-2 transition-colors">
                Home
              </a>
              <a href="/about" class="block hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-3 py-2 transition-colors">
                About
              </a>
              <a href="/projek" class="block hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-3 py-2 transition-colors">
                Projek
              </a>
              <a href="/sertifikat" class="block hover:border-black rounded-[5px] border-2 border-transparent hover:border-black hover:bg-white/20 px-3 py-2 transition-colors">
                Sertifikat
              </a>
            </div>
          </nav>
        </div>

        <!-- Main Container with top padding for floating navbar -->
        <div class="relative z-10 pt-24 sm:pt-28 pb-16 max-w-4xl mx-auto px-4 sm:px-6">
          <slot />
        </div>
      </>
    )}

    <!-- Smooth scrolling library Lenis & Mobile Menu & Theme Toggle script -->
    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;

      const initLayout = () => {
        if (lenis) {
          lenis.destroy();
        }

        lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          infinite: false,
          autoRaf: true,
        });

        window.addEventListener('lenis-stop', () => {
          lenis?.stop();
        });

        window.addEventListener('lenis-start', () => {
          lenis?.start();
        });

        // Global Scroll Animation Observer integrated with Lenis
        const revealElements = document.querySelectorAll('.reveal-left, .reveal-right, .reveal-bottom, .reveal-scale, .reveal-on-scroll');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-active', 'reveal-in');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.08,
            rootMargin: '0px 0px -30px 0px'
          });

          revealElements.forEach((el) => observer.observe(el));
        } else {
          revealElements.forEach((el) => el.classList.add('reveal-active', 'reveal-in'));
        }

        const themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          });
        }

        // Mobile Hamburger Menu handler
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');

        if (menuBtn && mobileMenu && hamburgerIcon && closeIcon) {
          menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
            menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
            
            mobileMenu.classList.toggle('hidden');
            mobileMenu.classList.toggle('flex');
            hamburgerIcon.classList.toggle('hidden');
            hamburgerIcon.classList.toggle('block');
            closeIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('block');
          });

          // Close mobile menu when clicking outside
          document.addEventListener('click', (e) => {
            if (!mobileMenu.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
              menuBtn.setAttribute('aria-expanded', 'false');
              mobileMenu.classList.add('hidden');
              mobileMenu.classList.remove('flex');
              hamburgerIcon.classList.remove('hidden');
              hamburgerIcon.classList.add('block');
              closeIcon.classList.add('hidden');
              closeIcon.classList.remove('block');
            }
          });
        }
      };

      document.addEventListener('astro:page-load', initLayout);
    </script>
  </body>
</html>
